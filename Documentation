h.	Created a new table using inner join between calories, intensities and steps - 
CREATE TABLE fitabase.joined_table AS
SELECT
  a.* EXCEPT(Id, ActivityDate, ActivityTime), -- Exclude common columns from table a
  b.* EXCEPT(Id, ActivityDate, ActivityTime), -- Exclude common columns from table b
  c.*
FROM
  fitabase.HourlyCalories a
INNER JOIN
  fitabase.HourlyIntensities b
ON
  a.Id = b.Id AND a.ActivityDate = b.ActivityDate AND a.ActivityTime = b.ActivityTime
INNER JOIN
  fitabase.HourlySteps c
ON
  a.Id = c.Id AND a.ActivityDate = c.ActivityDate AND a.ActivityTime = c.ActivityTime
ORDER BY ActivityDate, ActivityTime;

