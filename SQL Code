k.	User Category - 
SELECT Id,
  TotalUsers,
  CASE
    WHEN TotalUsers BETWEEN 27 AND 31 THEN 'Active User'
    WHEN TotalUsers BETWEEN 16 AND 26 THEN 'Regular User'
    WHEN TotalUsers BETWEEN 0 AND 15 THEN 'Casual User'
