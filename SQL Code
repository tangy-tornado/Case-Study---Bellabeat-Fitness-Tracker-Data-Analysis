s.	Steps-Sleep - 
SELECT
  sd.id,
  CAST(AVG(dailyactivity.totalsteps) AS INT64) AS AvgTotalSteps,
  dailyactivity.Weekday AS Weekday,
  CAST(ROUND(AVG(sd.totaltimeinbed), 2) AS INT64) AS AvgTimeinBed,
  CAST(ROUND(AVG(sd.totalminutesasleep), 2) AS INT64) AS AvgTimeAsleep,
  CAST(ROUND(AVG(sd.totaltimeinbed - sd.totalminutesasleep), 2) AS INT64) AS AvgTimeAwake
FROM
  `fitabase.SleepDay` sd
INNER JOIN
  `fitabase.NewDailyActivity` dailyactivity
ON
  dailyactivity.id = sd.id
GROUP BY
  sd.id, dailyactivity.Weekday
ORDER BY
  6 DESC;
t.	SleepPercent -
SELECT id,
COUNT(id) AS NumOfEntry,
ROUND((AVG(TotalMinutesAsleep))/60) AS AvgHoursAsleep,
MIN(_OfTimeAsleep) AS MinPercentage,
MAX(_OfTimeAsleep) AS MaxPercentage,
ROUND(AVG(_OfTimeAsleep)) AS AvgPercentage
FROM `fitabase.SleepDay`
GROUP BY id
ORDER BY AvgHoursAsleep DESC
