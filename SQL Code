n.	UserLifestyle - 
SELECT
  Id,
  CAST(ROUND(AVG(TotalSteps)) AS INT64) AS AvgTotalSteps,
  CASE
    WHEN ROUND(AVG(TotalSteps)) < 5000 THEN 'Minimal Activity'
    WHEN ROUND(AVG(TotalSteps)) BETWEEN 5000 AND 7499 THEN 'Easygoing Activity'
    WHEN ROUND(AVG(TotalSteps)) BETWEEN 7500 AND 9999 THEN 'Steady Activity'
    WHEN ROUND(AVG(TotalSteps)) BETWEEN 10000 AND 12499 THEN 'Regular Activity'
    WHEN ROUND(AVG(TotalSteps)) > 12499 THEN 'Intense Activity'
  END AS TotalStepsIndex
FROM
  `fitabase.DailyActivity`
GROUP BY
  Id

o.	WHORecommendation - 
SELECT
  Id,
  CAST(AVG(veryactiveminutes) + AVG(fairlyactiveminutes) + AVG(lightlyactiveminutes) AS INT64) AS TotalAvgActiveMins,
  CASE
    WHEN AVG(veryactiveminutes) + AVG(fairlyactiveminutes) + AVG(lightlyactiveminutes) >= 300 THEN 'Exceeds WHO'
    WHEN AVG(veryactiveminutes) + AVG(fairlyactiveminutes) + AVG(lightlyactiveminutes) BETWEEN 150 AND 300 THEN 'Meets WHO'
    WHEN AVG(veryactiveminutes) + AVG(fairlyactiveminutes) + AVG(lightlyactiveminutes) < 150 THEN 'Below WHO'
  END AS WHORecommendation
FROM
  `fitabase.DailyActivity`
GROUP BY Id
ORDER BY TotalAvgActiveMins;
p.	I needed to create a weekday column in DailyActivvity using Sleepday column from SleepDay table so - 
CREATE TABLE `fitabase.NewDailyActivity` AS
SELECT
  da.*,
  sd.unique_weekday AS new_weekday
FROM (
  SELECT
    SleepDay,
    MAX(weekday) AS unique_weekday  -- Use an appropriate aggregation function
  FROM
    `fitabase.SleepDay`
  GROUP BY
    SleepDay) sd
JOIN
  `fitabase.DailyActivity` da
ON
  sd.SleepDay = da.ActivityDate;

To verify the create table date matches the old table - 
SELECT
  COUNT(*) AS total_records,
  COUNTIF(d1.ActivityDate IS NULL OR d2.ActivityDate IS NULL) AS mismatched_records
FROM
  `fitabase.DailyActivity` d1
FULL OUTER JOIN
  `fitabase.NewDailyActivity` d2
ON
  d1.ActivityDate = d2.ActivityDate;
